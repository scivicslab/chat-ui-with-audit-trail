# OpenCode for agent-connector-kernel's Podman confinement (tasks/todo.md, stage 9).
# Build from agent-connector-kernel/containers:  podman build -f opencode/Containerfile -t localhost/ack-opencode:1.19.6 .
# Version: opencode-ai 1.19.6, the latest release (GitHub anomalyco/opencode v1.19.6, marked Latest; npm registry
# opencode-ai latest = 1.19.6), checked 2026-11-22. The OpenCode 1 docs give `npm install -g opencode-ai`
# (https://opencode.ai/v1/docs). The current docs at opencode.ai/docs describe OpenCode 2, which has no release yet.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update \
 && apt-get install -y --no-install-recommends socat ca-certificates nodejs npm \
 && npm install -g opencode-ai@1.19.6 \
 && rm -rf /var/lib/apt/lists/* /root/.npm
COPY ack-relay /usr/local/bin/ack-relay
RUN chmod 0755 /usr/local/bin/ack-relay \
 && groupadd -g 1001 agent && useradd -m -u 1001 -g 1001 -d /home/agent -s /bin/bash agent \
 && mkdir -p /home/agent/.config/opencode && chown -R agent:agent /home/agent
USER agent
ENV HOME=/home/agent
# Nothing is fetched at run time (tasks/todo.md, stage 9 part 3). Two sources of fetches in OpenCode 1.19.6:
# - Config loading installs @opencode-ai/plugin at OpenCode's own version into every config directory, in the
#   background (packages/opencode/src/config/config.ts, Npm.install). Npm.install does nothing when node_modules exists
#   and every declared package is in package-lock.json's root (packages/core/src/npm.ts), so it is installed here.
#   The provider package @ai-sdk/openai-compatible needs nothing: it is bundled (provider/provider.ts, BUNDLED_PROVIDERS).
# - The models.dev catalogue, fetched from models.opencode.ai unless OPENCODE_DISABLE_MODELS_FETCH is set
#   (packages/core/src/models-dev.ts; https://opencode.ai/v1/docs/cli, environment variables).
RUN cd /home/agent/.config/opencode && npm install --no-audit --no-fund @opencode-ai/plugin@1.19.6 && rm -rf /home/agent/.npm
ENV OPENCODE_DISABLE_MODELS_FETCH=1
WORKDIR /work
