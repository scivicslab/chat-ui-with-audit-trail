<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.scivicslab</groupId>
    <artifactId>chat-ui-with-audit-trail-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>agent-connector-kernel</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!-- agent-connector-kernel: the headless side of chat-ui-with-audit-trail (the tool registry, the
       tool runner, the MCP tool endpoint and the plain tools), which nigsc-connector will ship without
       the screen and the record. It must run outside Quarkus, so the enforcer below fails the build
       when any Quarkus, CDI, MicroProfile or Vert.x artifact reaches it, directly or transitively.
       Dependencies are added as classes move in, one stage at a time (tasks/todo.md). -->
  <dependencies>
    <dependency>
      <groupId>com.scivicslab</groupId>
      <artifactId>chat-ui-with-audit-trail-plugin-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>no-framework-in-agent-connector-kernel</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>io.quarkus*</exclude>
                    <exclude>io.quarkiverse*</exclude>
                    <exclude>jakarta.*</exclude>
                    <exclude>javax.inject</exclude>
                    <exclude>javax.enterprise</exclude>
                    <exclude>org.eclipse.microprofile*</exclude>
                    <exclude>io.smallrye*</exclude>
                    <exclude>io.vertx*</exclude>
                  </excludes>
                  <message>agent-connector-kernel must run without Quarkus: no Quarkus, CDI, MicroProfile, SmallRye or Vert.x artifact may reach it (tasks/todo.md, stage 2).</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
